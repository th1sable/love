{
  "expo": {
    "name": "love",
    "slug": "love",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.th1sable.love"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.th1sable.love"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "love",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F5D367",
          "defaultChannel": "love"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Scegli le foto da conservare nei vostri album privati.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93d7bf81-70ed-470a-8137-bb999ce70adb"
      }
    },
    "owner": "thisable"
  }
}
